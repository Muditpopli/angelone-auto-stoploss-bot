# Copy this file to .env and fill in your real values.
# .env is gitignored -- never commit real credentials.
#
# See SETUP.md for how to obtain the API key (SmartAPI portal) and the
# TOTP secret (the base32 string behind your 2FA QR code, not a live
# 6-digit code).

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
